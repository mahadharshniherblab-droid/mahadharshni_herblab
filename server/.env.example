# Copy this file to .env and fill in the values.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Pricing (rupees) ----
REGULAR_PRICE=399
# Flat discount applied to every order, every unit (no first-order restriction).
DISCOUNT_PERCENT=10

# ---- Owner login ----
# Password for /admin. The login code is emailed to ADMIN_EMAIL.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Any long random string; it signs the admin session token.
SESSION_SECRET=

# ---- Email (Resend) - used to send the admin login code ----
RESEND_API_KEY=
# Must be a Resend-verified sender. The default below only delivers to the Resend account owner.
RESEND_FROM=Mahadharshni Herblab <onboarding@resend.dev>

# ---- Cloudinary - used for images uploaded from the admin dashboard ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mahadharshni-herblab

# ---- Google Sheets (database) ----
# Leave blank to run with an in-memory store (data is lost on restart) - fine for local development.
GOOGLE_SHEET_ID=
# Service-account credentials (share the sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for line breaks, wrapped in double quotes
GOOGLE_PRIVATE_KEY=

# ---- Razorpay (backend only; use test keys until ready for live payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
